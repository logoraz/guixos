;; -*- mode: scheme; -*-

;; Use globally
(use-modules (ice-9 readline)
             (ice-9 format)
             (ice-9 pretty-print)
             (ice-9 colorized))

(activate-readline)
(activate-colorized)

;; G-Golf recommended duplicate binding handler
(use-modules (oop goops))
(default-duplicate-binding-handler
  '(merge-generics replace warn-override-core warn last))
